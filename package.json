{
	"name": "opencv-react-face-detection",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"format": "oxfmt",
		"lint": "oxlint",
		"check": "oxfmt && oxlint --fix",
    "tfrm": "cd deploy && node rmtf.mjs",
		"tfinit": "cd deploy && terraform init -upgrade",
		"tfapply": "cd deploy && terraform apply -auto-approve",
		"deploy": "bun run build && cd deploy && terraform apply -auto-approve",
		"destroy": "cd deploy && terraform destroy -auto-approve"
	},
	"dependencies": {
		"@techstark/opencv-js": "^5.0.0-release.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.2",
		"react-webcam": "^7.2.0"
	},
	"devDependencies": {
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"globals": "^17.11.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-plugin-cdn-import": "^1.0.1"
	}
}
